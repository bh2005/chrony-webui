# API-Schlüssel für die WebUI (beliebig, min. 16 Zeichen)
CHRONYWEBUI_API_KEY=changeme-please-set-a-secure-key

# Pfad zur chrony.conf (Standard Debian)
CHRONYWEBUI_CHRONY_CONF_PATH=/etc/chrony/chrony.conf

# Pfad zu chronyc
CHRONYWEBUI_CHRONYC_PATH=/usr/bin/chronyc

# Kommando für chrony reload nach Konfigurationsänderung
CHRONYWEBUI_RELOAD_COMMAND=systemctl reload chrony

# ACME (interne K+S step-CA) — Zertifikat-Tab
# Pfad zum installierten acme.sh (siehe Scripts/acme/01-setup-acme-client.sh)
CHRONYWEBUI_ACME_SH_PATH=/etc/acme/acme.sh
# Directory-URL der internen CA
CHRONYWEBUI_ACME_CA_URL=https://dekdli047.corp.k-plus-s.net/acme/acme/directory
# acme.sh Cert-Home (Zwischenablage der Zertifikate/Keys von acme.sh selbst)
CHRONYWEBUI_ACME_CERT_HOME=/etc/acme/certs
# Webroot für HTTP-01-Validierung — muss dem Nginx-`root` entsprechen
CHRONYWEBUI_ACME_WEBROOT=/var/www/chrony-webui
# Standard-E-Mail für die ACME-Account-Registrierung
CHRONYWEBUI_ACME_EMAIL=monitoring@k-plus-s.com
# Zielverzeichnis für das von der WebUI verwaltete Zertifikat (fullchain.pem/privkey.pem)
CHRONYWEBUI_CERT_INSTALL_DIR=/etc/ssl/chrony-webui
# Kommando nach Ausstellung/Erneuerung, um den Webserver mit dem neuen Zertifikat neu zu laden
CHRONYWEBUI_CERT_DEPLOY_RELOAD_COMMAND=systemctl reload nginx
